<Window x:Class="Cre8Labs.IPSwitcher.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="Assets/app.ico"
        Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource Ink}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <StackPanel>
    <Border Height="3" Background="{StaticResource BrandGradientH}" />
    <DockPanel Margin="24,22,24,0">
      <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="{StaticResource WarningSoft}" VerticalAlignment="Top">
        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" Foreground="{StaticResource Warning}" FontSize="18"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Margin="16,0,0,0">
        <TextBlock x:Name="HeadingText" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" />
      </StackPanel>
    </DockPanel>
    <Border Margin="0,22,0,0" Padding="24,14,24,18" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Width="96" IsCancel="True" IsDefault="True" Click="Cancel_Click" />
        <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Confirm_Click" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
