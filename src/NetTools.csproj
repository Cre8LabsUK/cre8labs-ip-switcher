<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>Cre8Labs-NetTools</AssemblyName>
    <RootNamespace>Cre8Labs.NetTools</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Build with -p:NoElevate=true for a read-only preview build that does not ask for admin. -->
    <ApplicationManifest Condition="'$(NoElevate)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(NoElevate)' == 'true'">app.preview.manifest</ApplicationManifest>
    <Company>Cre8Labs</Company>
    <Product>Cre8Labs Net Tools</Product>
    <AssemblyTitle>Cre8Labs Net Tools</AssemblyTitle>
    <Description>One-click IP presets for Windows network adapters</Description>
    <Copyright>Copyright (c) 2026 Cre8Labs</Copyright>
    <Version>1.1.0</Version>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\mark.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetTools.Tests" />
  </ItemGroup>

</Project>
