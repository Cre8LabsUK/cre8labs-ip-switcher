<Window x:Class="Cre8Labs.NetTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cre8Labs Net Tools"
        Width="1200" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource Ink}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <ContextMenu x:Key="PresetMenu" x:Shared="False">
      <MenuItem Header="Apply" Tag="&#xE73E;" Click="MenuApply_Click" />
      <MenuItem Header="Edit..." Tag="&#xE70F;" Click="MenuEdit_Click" />
      <MenuItem Header="Duplicate" Tag="&#xE8C8;" Click="MenuDuplicate_Click" />
      <Separator />
      <MenuItem Header="Move left" Tag="&#xE76B;" Click="MenuMoveLeft_Click" />
      <MenuItem Header="Move right" Tag="&#xE76C;" Click="MenuMoveRight_Click" />
      <Separator />
      <MenuItem Header="Delete" Tag="&#xE74D;" Foreground="{StaticResource Danger}" Click="MenuDelete_Click" />
    </ContextMenu>

    <!-- Preset tile: lifts on hover, gradient ring when active -->
    <Style x:Key="TileButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform x:Name="scale" />
              </Grid.RenderTransform>
              <Border x:Name="card" CornerRadius="14" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Border.Effect>
                  <DropShadowEffect x:Name="shadow" BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.06" Color="#0E2744" />
                </Border.Effect>
              </Border>
              <Border x:Name="ring" CornerRadius="14" BorderBrush="{StaticResource BrandGradient}" BorderThickness="2" Opacity="0" />
              <Border x:Name="focus" CornerRadius="14" BorderBrush="{StaticResource Teal}" BorderThickness="2" Opacity="0" />
              <ContentPresenter Margin="{TemplateBinding Padding}" />
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="ring" Property="Opacity" Value="1" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.18" />
                      <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="BlurRadius" To="26" Duration="0:0:0.18" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity" To="0.06" Duration="0:0:0.2" />
                      <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="BlurRadius" To="18" Duration="0:0:0.2" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08" />
                      <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                      <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="focus" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="root" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Navigation rail item: Tag is the icon glyph -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="GroupName" Value="Nav" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="bd" CornerRadius="12" Background="Transparent" Padding="4,10,4,9">
                <StackPanel>
                  <TextBlock x:Name="icon" FontFamily="{StaticResource IconFont}" Text="{TemplateBinding Tag}" FontSize="18"
                             HorizontalAlignment="Center" Foreground="{StaticResource Muted}" />
                  <ContentPresenter x:Name="label" HorizontalAlignment="Center" Margin="0,5,0,0"
                                    TextElement.FontSize="11" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Muted}" />
                </StackPanel>
              </Border>
              <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="-10,10,0,10" CornerRadius="2"
                      Background="{StaticResource BrandGradient}" Opacity="0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource TealSoft}" />
                <Setter TargetName="icon" Property="Foreground" Value="{StaticResource Blue}" />
                <Setter TargetName="label" Property="TextElement.Foreground" Value="{StaticResource Ink}" />
                <Setter TargetName="bar" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Teal}" />
                <Setter TargetName="bd" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Background" Value="{StaticResource PurpleSoft}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PoolLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Margin" Value="0,10,0,5" />
    </Style>
    <Style x:Key="PoolError" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource Danger}" />
      <Setter Property="Margin" Value="2,4,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Visibility" Value="Collapsed" />
    </Style>
    <Style x:Key="ColumnHead" TargetType="TextBlock" BasedOn="{StaticResource Overline}">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Footer toggles: Tag is the icon glyph, Content is the label -->
    <Style x:Key="FooterToggle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" CornerRadius="8" Padding="10,5" Background="Transparent">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="{TemplateBinding Tag}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{StaticResource Muted}" />
                <ContentPresenter TextElement.FontSize="12.5" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource TealSoft}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- "Advanced" disclosure: chevron turns when open -->
    <Style x:Key="Disclosure" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" Background="Transparent" Padding="0,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="chev" FontFamily="{StaticResource IconFont}" Text="&#xE76C;" FontSize="10" VerticalAlignment="Center"
                           Foreground="{StaticResource Blue}" RenderTransformOrigin="0.5,0.5" Margin="0,1,8,0">
                  <TextBlock.RenderTransform>
                    <RotateTransform />
                  </TextBlock.RenderTransform>
                </TextBlock>
                <ContentPresenter TextElement.FontSize="12.5" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Blue}" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="chev" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="90" />
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="Height" Value="22" />
    </Style>

    <Style x:Key="DetailLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Margin" Value="0,5,16,5" />
    </Style>
    <Style x:Key="DetailValue" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Margin" Value="0,5,0,5" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Window.Resources>

  <Border x:Name="RootBorder">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="56" />
        <RowDefinition Height="3" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="44" />
      </Grid.RowDefinitions>

      <!-- ===== Title bar ===== -->
      <Grid Grid.Row="0" Background="{StaticResource Surface}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Image Source="Assets/mark.png" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock VerticalAlignment="Center" Margin="10,0,0,1" FontFamily="{StaticResource DisplayFont}" FontSize="19" Foreground="{StaticResource Navy}">
            <Run Text="Cre8" FontWeight="Bold" /><Run Text="Labs" />
          </TextBlock>
          <Border Width="1" Height="20" Background="{StaticResource Line}" Margin="14,0" />
          <TextBlock Text="Net Tools" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button Style="{StaticResource CaptionButton}" Content="&#xE765;" FontSize="15" Height="56" Click="Shortcuts_Click"
                  WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Keyboard shortcuts" AutomationProperties.Name="Keyboard shortcuts" />
          <Border Width="1" Height="20" Background="{StaticResource Line}" Margin="6,0" VerticalAlignment="Center" />
          <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Height="56" Click="Min_Click" AutomationProperties.Name="Minimize"
                  WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" />
          <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Height="56" Click="Max_Click" AutomationProperties.Name="Maximize"
                  WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize" />
          <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Height="56" Click="Close_Click" AutomationProperties.Name="Close"
                  WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{StaticResource BrandGradientH}" />

      <!-- ===== Body: navigation rail + pages ===== -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <StackPanel Width="72" Margin="10,16,10,0">
            <RadioButton x:Name="NavAdapter" Style="{StaticResource NavItem}" Tag="&#xE839;" Content="Adapter" IsChecked="True"
                         Checked="Nav_Checked" AutomationProperties.Name="Adapter page" ToolTip="Presets and adapter settings" />
            <RadioButton x:Name="NavPool" Style="{StaticResource NavItem}" Tag="&#xE968;" Content="DHCP pool"
                         Checked="Nav_Checked" AutomationProperties.Name="DHCP pool page" ToolTip="Hand out addresses to devices" />
            <RadioButton x:Name="NavScan" Style="{StaticResource NavItem}" Tag="&#xE721;" Content="Scan"
                         Checked="Nav_Checked" AutomationProperties.Name="Scan page" ToolTip="Find devices on the network" />
            <RadioButton x:Name="NavMonitor" Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="Monitor"
                         Checked="Nav_Checked" AutomationProperties.Name="Monitor page" ToolTip="Watch many devices at once" />
            <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="Tools"
                         Checked="Nav_Checked" AutomationProperties.Name="Tools page" ToolTip="Port check, RTSP, traceroute, DNS, link health" />
          </StackPanel>
        </Border>
      <Grid Grid.Column="1" Margin="22,18,22,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="340" />
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3">
        <!-- Admin warning (preview builds only) -->
        <Border Margin="0,0,0,16" CornerRadius="12" Padding="16,10" Background="{StaticResource WarningSoft}"
                Visibility="{Binding NotAdmin, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="34" Content="Restart as admin" Click="RestartAdmin_Click" />
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" Foreground="{StaticResource Warning}" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Warning}" FontWeight="SemiBold"
                       Text="Read-only mode. Changing IP settings needs administrator rights." />
          </DockPanel>
        </Border>

        <!-- DHCP pool running banner -->
        <Border Margin="0,0,0,16" CornerRadius="12" Padding="16,9" Visibility="{Binding PoolActive, Converter={StaticResource BoolToVis}}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{StaticResource TealSoft}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding PoolKind}" Value="waiting">
                  <Setter Property="Background" Value="{StaticResource WarningSoft}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource SecondaryButton}" Height="34" Content="{Binding DevicesButtonText}" Click="ShowDevices_Click" />
              <Button Style="{StaticResource SecondaryButton}" Height="34" Margin="8,0,0,0" Content="Stop pool" Foreground="{StaticResource Danger}"
                      Click="StopPool_Click" AutomationProperties.Name="Stop DHCP pool" />
            </StackPanel>
            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{StaticResource Success}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PoolKind}" Value="waiting">
                      <Setter Property="Fill" Value="{StaticResource Warning}" />
                    </DataTrigger>
                    <EventTrigger RoutedEvent="Loaded">
                      <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Margin="10,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding PoolBanner}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>
        </StackPanel>
        <!-- ===== Left column: adapter + ping ===== -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="-12,-12,-12,0" Padding="12,12,12,0">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Refresh_Click" AutomationProperties.Name="Refresh adapters" ToolTip="Refresh (F5)" Margin="0,-10,-10,0" />
                <TextBlock Style="{StaticResource Overline}" Text="NETWORK ADAPTER" VerticalAlignment="Center" />
              </DockPanel>
              <ComboBox x:Name="AdapterCombo" Style="{StaticResource Combo}" Height="52" Margin="0,8,0,0"
                        ItemsSource="{Binding Adapters}" SelectionChanged="Adapter_SelectionChanged">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsUp}" Value="True">
                        <Setter TargetName="dot" Property="Fill" Value="{StaticResource Success}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Border Height="1" Background="{StaticResource Line}" Margin="0,18" />

              <TextBlock Style="{StaticResource Overline}" Text="CURRENT ADDRESS" />
              <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" Click="CopyIp_Click" AutomationProperties.Name="Copy IP address" ToolTip="Copy IP" VerticalAlignment="Center" Margin="0,0,-10,0" />
                <TextBlock VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Status.Ip, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="25" FontWeight="SemiBold" />
                  <Run Text="{Binding Status.Prefix, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="16" Foreground="{StaticResource Faint}" />
                </TextBlock>
              </DockPanel>

              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Border>
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                      <Setter Property="Background" Value="{StaticResource PurpleSoft}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Status.IsDhcp}" Value="True">
                          <Setter Property="Background" Value="{StaticResource TealSoft}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Status.ModeText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Purple}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Status.IsDhcp}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Blue}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
                <Border Margin="8,0,0,0" CornerRadius="11" Padding="9,3" Height="22" Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{StaticResource Faint}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status.IsUp}" Value="True">
                              <Setter Property="Fill" Value="{StaticResource Success}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Status.LinkText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel x:Name="AdapterExtra">
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource DetailLabel}" Text="Gateway" />
                <TextBlock Style="{StaticResource DetailValue}" Grid.Column="1" Text="{Binding Status.Gateway}" />
                <TextBlock Style="{StaticResource DetailLabel}" Grid.Row="1" Text="DNS" />
                <TextBlock Style="{StaticResource DetailValue}" Grid.Row="1" Grid.Column="1" Text="{Binding Status.Dns}" ToolTip="{Binding Status.Dns}" />
                <TextBlock Style="{StaticResource DetailLabel}" Grid.Row="2" Text="MAC" />
                <TextBlock Style="{StaticResource DetailValue}" Grid.Row="2" Grid.Column="1" Text="{Binding Status.Mac}" />
                <TextBlock Style="{StaticResource DetailLabel}" Grid.Row="3" Text="Extra IPs"
                           Visibility="{Binding Status.HasExtra, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource DetailValue}" Grid.Row="3" Grid.Column="1" Text="{Binding Status.Extra}" TextWrapping="Wrap"
                           Visibility="{Binding Status.HasExtra, Converter={StaticResource BoolToVis}}" />
              </Grid>

              <Border Margin="0,10,0,0" CornerRadius="10" Padding="12,8" Background="{StaticResource SurfaceAlt}"
                      Visibility="{Binding Status.HasNote, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Status.Note}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" />
              </Border>

              <Button Style="{StaticResource SecondaryButton}" Margin="0,16,0,0" HorizontalAlignment="Stretch" Click="OpenNcpa_Click" AutomationProperties.Name="Windows network connections">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE839;" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock Text="Windows network connections" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- DHCP pool -->
          <Border x:Name="PoolCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
            <StackPanel>
              <DockPanel>
                <Border DockPanel.Dock="Right" CornerRadius="11" Padding="9,3" Height="22" Visibility="{Binding PoolActive, Converter={StaticResource BoolToVis}}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding PoolKind}" Value="waiting">
                          <Setter Property="Background" Value="{StaticResource WarningSoft}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PoolKind}" Value="checking">
                          <Setter Property="Background" Value="{StaticResource TealSoft}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding PoolChipText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Success}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding PoolKind}" Value="waiting">
                            <Setter Property="Foreground" Value="{StaticResource Warning}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding PoolKind}" Value="checking">
                            <Setter Property="Foreground" Value="{StaticResource Blue}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
                <TextBlock Style="{StaticResource Overline}" Text="DHCP POOL" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="{Binding PoolSubtitle}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />

              <!-- Set up (pool stopped) -->
              <StackPanel Visibility="{Binding PoolIdle, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource PoolLabel}" Text="Network to serve" />
                <TextBox x:Name="PoolNetworkBox" Style="{StaticResource MonoField}" Tag="192.168.1.0/24" TextChanged="PoolNetwork_Changed"
                         AutomationProperties.Name="Pool network" />
                <TextBlock x:Name="PoolNetworkError" Style="{StaticResource PoolError}" />
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Height="30" Padding="2,0" Margin="-2,4,0,0"
                        Foreground="{StaticResource Blue}" FontWeight="SemiBold" FontSize="12.5" Click="PoolFromAdapter_Click"
                        Content="Use this adapter's current network" />

                <ToggleButton x:Name="PoolAdvancedToggle" Style="{StaticResource Disclosure}" Content="Server address, range and lease" Margin="0,2,0,0" />
                <Grid Visibility="{Binding IsChecked, ElementName=PoolAdvancedToggle, Converter={StaticResource BoolToVis}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource PoolLabel}" Text="This PC's address" />
                    <TextBox x:Name="PoolServerBox" Style="{StaticResource MonoField}" TextChanged="PoolField_Changed" AutomationProperties.Name="Server address" />
                    <TextBlock x:Name="PoolServerError" Style="{StaticResource PoolError}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource PoolLabel}" Text="Lease (minutes)" />
                    <TextBox x:Name="PoolLeaseBox" Style="{StaticResource MonoField}" TextChanged="PoolField_Changed" AutomationProperties.Name="Lease minutes" />
                    <TextBlock x:Name="PoolLeaseError" Style="{StaticResource PoolError}" />
                  </StackPanel>
                  <StackPanel Grid.Row="1">
                    <TextBlock Style="{StaticResource PoolLabel}" Text="Range start" />
                    <TextBox x:Name="PoolStartBox" Style="{StaticResource MonoField}" TextChanged="PoolField_Changed" AutomationProperties.Name="Range start" />
                    <TextBlock x:Name="PoolStartError" Style="{StaticResource PoolError}" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Style="{StaticResource PoolLabel}" Text="Range end" />
                    <TextBox x:Name="PoolEndBox" Style="{StaticResource MonoField}" TextChanged="PoolField_Changed" AutomationProperties.Name="Range end" />
                    <TextBlock x:Name="PoolEndError" Style="{StaticResource PoolError}" />
                  </StackPanel>
                  <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource PoolLabel}" Text="Gateway (optional)" />
                    <TextBox x:Name="PoolGatewayBox" Style="{StaticResource MonoField}" Tag="None" TextChanged="PoolField_Changed" AutomationProperties.Name="Pool gateway" />
                    <TextBlock x:Name="PoolGatewayError" Style="{StaticResource PoolError}" />
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Style="{StaticResource PoolLabel}" Text="DNS (optional)" />
                    <TextBox x:Name="PoolDnsBox" Style="{StaticResource MonoField}" Tag="None" TextChanged="PoolField_Changed" AutomationProperties.Name="Pool DNS" />
                    <TextBlock x:Name="PoolDnsError" Style="{StaticResource PoolError}" />
                  </StackPanel>
                </Grid>

                <Border Margin="0,12,0,0" CornerRadius="10" Padding="12,9" Background="{StaticResource SurfaceAlt}">
                  <TextBlock x:Name="PoolPreview" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                </Border>
                <Button Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch" Click="StartPool_Click"
                        AutomationProperties.Name="Start DHCP pool">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0" />
                    <TextBlock Text="Start DHCP pool" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <!-- Running -->
              <StackPanel Visibility="{Binding PoolActive, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource DetailLabel}" Text="Adapter" />
                  <TextBlock Style="{StaticResource DetailValue}" Grid.Column="1" Text="{Binding PoolAdapterText}" FontFamily="{StaticResource UiFont}" />
                  <TextBlock Style="{StaticResource DetailLabel}" Grid.Row="1" Text="This PC" />
                  <TextBlock Style="{StaticResource DetailValue}" Grid.Row="1" Grid.Column="1" Text="{Binding PoolServerText}" />
                  <TextBlock Style="{StaticResource DetailLabel}" Grid.Row="2" Text="Range" />
                  <TextBlock Style="{StaticResource DetailValue}" Grid.Row="2" Grid.Column="1" Text="{Binding PoolRangeText}" />
                  <TextBlock Style="{StaticResource DetailLabel}" Grid.Row="3" Text="Devices" />
                  <TextBlock Style="{StaticResource DetailValue}" Grid.Row="3" Grid.Column="1" Text="{Binding DeviceCountText}" FontFamily="{StaticResource UiFont}" />
                </Grid>
                <DockPanel Margin="0,14,0,0">
                  <Button Style="{StaticResource SecondaryButton}" Content="Stop DHCP pool" HorizontalAlignment="Stretch" Foreground="{StaticResource Danger}"
                          Click="StopPool_Click" AutomationProperties.Name="Stop DHCP pool" />

                </DockPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border x:Name="PingCard" Style="{StaticResource Card}" Margin="0,16,0,16">
            <StackPanel>
              <TextBlock Style="{StaticResource Overline}" Text="QUICK PING" />
              <TextBlock Text="{Binding PingSource}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
              <DockPanel Margin="0,10,0,0">
                <Button x:Name="PingButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Ping" Margin="8,0,0,0" Width="76" Click="Ping_Click" />
                <TextBox x:Name="PingBox" Style="{StaticResource MonoField}" Tag="Gateway or address" KeyDown="PingBox_KeyDown" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding PingResults}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <Ellipse x:Name="dot" Width="7" Height="7" Fill="{StaticResource Danger}" VerticalAlignment="Center" Margin="2,0,8,0" />
                      <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Ok}" Value="True">
                        <Setter TargetName="dot" Property="Fill" Value="{StaticResource Success}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

        </StackPanel>
        </ScrollViewer>

        <!-- ===== Adapter page: presets ===== -->
        <Grid x:Name="AdapterPage" Grid.Row="1" Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <CheckBox x:Name="AddExtraSwitch" AutomationProperties.Name="Add as extra IP" Style="{StaticResource Switch}" Content="Add as extra IP" VerticalAlignment="Center"
                        ToolTip="Add the preset IP alongside the current static IP instead of replacing it" />
              <Button Style="{StaticResource PrimaryButton}" Margin="18,0,0,0" Click="NewPreset_Click" ToolTip="New preset (Ctrl+N)" AutomationProperties.Name="New preset">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0" />
                  <TextBlock Text="New preset" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Presets" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ShortcutHint}" FontSize="12.5" Foreground="{StaticResource Muted}"
                         Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>

          <!-- DHCP tile -->
          <Button x:Name="DhcpTile" Grid.Row="1" Style="{StaticResource TileButton}" Height="78" Margin="0,0,14,14" Click="Dhcp_Click" AutomationProperties.Name="Switch to DHCP"
                  DataContext="{Binding DhcpItem}">
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource BrandGradient}" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE895;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Control Template="{StaticResource SpinnerTemplate}" Margin="0,0,12,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Border Style="{StaticResource Chip}" Background="{StaticResource SuccessSoft}" Margin="0,0,12,0"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="Active" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Success}" VerticalAlignment="Center" />
                </Border>
                <Border MinWidth="26" Height="26" Padding="7,0" CornerRadius="7" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        Visibility="{Binding HasHotkey, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="{Binding HotkeyText}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </StackPanel>
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Automatic (DHCP)" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="Let the router hand out the address and DNS" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
              </StackPanel>
            </DockPanel>
          </Button>

          <!-- Preset tiles -->
          <ScrollViewer x:Name="PresetScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                        Margin="-12,-12,0,0" Padding="12,12,0,0">
            <Grid>
              <ItemsControl x:Name="PresetList" ItemsSource="{Binding Presets}" Focusable="False" SizeChanged="PresetList_SizeChanged">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource TileButton}" Height="122" Margin="0,0,14,14"
                            Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Click="PresetTile_Click" ContextMenu="{StaticResource PresetMenu}" ToolTip="{Binding Tooltip}"
                            AutomationProperties.Name="{Binding Name, StringFormat=Apply {0}}">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                          <Border DockPanel.Dock="Left" MinWidth="24" Height="24" Padding="6,0" Margin="0,0,10,0" CornerRadius="6" Background="{StaticResource SurfaceAlt}"
                                  BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Center"
                                  Visibility="{Binding HasHotkey, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding HotkeyText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="0,-6,-8,0"
                                  Content="&#xE712;" Click="More_Click" ContextMenu="{StaticResource PresetMenu}" ToolTip="More"
                                  AutomationProperties.Name="{Binding Name, StringFormat=More options for {0}}" />
                          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="0,0,4,0"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Ip, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="19" FontWeight="SemiBold" />
                          <Run Text="{Binding PrefixText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="13.5" Foreground="{StaticResource Faint}" />
                        </TextBlock>
                        <DockPanel Grid.Row="2" Height="22">
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Control Template="{StaticResource SpinnerTemplate}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            <Border Style="{StaticResource Chip}" Background="{StaticResource SuccessSoft}"
                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                              <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="Active" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Success}" VerticalAlignment="Center" />
                              </StackPanel>
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Empty state -->
              <Border Visibility="{Binding NoPresets, Converter={StaticResource BoolToVis}}" Margin="0,0,14,0" Padding="24,32"
                      CornerRadius="14" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Background="{StaticResource SurfaceAlt}">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="No presets yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="Save the networks you switch between, then change IP in one click." Foreground="{StaticResource Muted}"
                             Margin="0,4,0,14" HorizontalAlignment="Center" />
                  <Button Style="{StaticResource PrimaryButton}" Content="Create your first preset" HorizontalAlignment="Center" Click="NewPreset_Click" />
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
        </Grid>

        <!-- ===== DHCP pool page: devices and reservations ===== -->
        <Grid x:Name="PoolPage" Grid.Row="1" Grid.Column="2" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource GhostButton}" Click="ReserveAll_Click" AutomationProperties.Name="Reserve all" ToolTip="Give every connected device a reservation at the address it has now">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE718;" FontSize="12" VerticalAlignment="Center" Margin="0,1,7,0" Foreground="{StaticResource Purple}" />
                  <TextBlock Text="Reserve all" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource GhostButton}" Click="AddReservation_Click" Margin="4,0,0,0" AutomationProperties.Name="Add device"
                      ToolTip="Reserve an address for a device by its MAC, before it is plugged in">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="11" VerticalAlignment="Center" Margin="0,1,7,0" Foreground="{StaticResource Blue}" />
                  <TextBlock Text="Add device" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Devices" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DevicesSummary}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14,10,8">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,8,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="104" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="92" />
                  <ColumnDefinition Width="108" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ColumnHead}" Text="STATUS" />
                <TextBlock Style="{StaticResource ColumnHead}" Grid.Column="1" Text="DEVICE" />
                <TextBlock Style="{StaticResource ColumnHead}" Grid.Column="2" Text="IP ADDRESS" />
                <TextBlock Style="{StaticResource ColumnHead}" Grid.Column="3" Text="LEASE" />
              </Grid>
              <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                  <ItemsControl ItemsSource="{Binding Devices}" Focusable="False" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="104" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="150" />
                              <ColumnDefinition Width="92" />
                              <ColumnDefinition Width="108" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <Ellipse x:Name="dot" Width="7" Height="7" Fill="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                              <TextBlock Text="{Binding StateText}" FontSize="12.5" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE718;" FontSize="11" Foreground="{StaticResource Purple}" VerticalAlignment="Center"
                                           Margin="0,1,6,0" Visibility="{Binding IsReserved, Converter={StaticResource BoolToVis}}" ToolTip="Reserved" />
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <TextBlock Text="{Binding SubLine}" FontSize="11.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Ip}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding MovingNote}" FontSize="11.5" Foreground="{StaticResource Warning}" TextWrapping="Wrap"
                                         Visibility="{Binding HasMovingNote, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding TimeLeft}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                              <Button Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="13" Content="&#xE774;" Click="OpenDevice_Click"
                                      IsEnabled="{Binding CanOpen}" ToolTip="Open its web page" AutomationProperties.Name="{Binding Name, StringFormat=Open {0} in browser}" />
                              <Button Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="13" Content="&#xE9D9;" Click="PingDevice_Click"
                                      IsEnabled="{Binding CanOpen}" ToolTip="Ping it" AutomationProperties.Name="{Binding Name, StringFormat=Ping {0}}" />
                              <Button Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="13" Content="&#xE718;" Click="AssignDevice_Click"
                                      ToolTip="{Binding AssignLabel}" AutomationProperties.Name="{Binding Name, StringFormat=Reserve IP for {0}}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding Kind}" Value="active">
                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Success}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="offered">
                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Teal}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="waiting">
                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Purple}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="No devices yet. Devices that get an address from the pool, and devices you reserve, appear here."
                           Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,12,8,0"
                           Visibility="{Binding NoDevices, Converter={StaticResource BoolToVis}}" />
              </Grid>
            </DockPanel>
          </Border>
        </Grid>

        <!-- ===== Scan page ===== -->
        <Grid x:Name="ScanPage" Grid.Row="1" Grid.Column="2" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Scan" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Find every device on the selected adapter's network, including cameras still on another subnet."
                       FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <DockPanel Grid.Row="1">
            <Button x:Name="ScanButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Width="120" Click="Scan_Click"
                    AutomationProperties.Name="Start or stop scan">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding ScanButtonIcon}" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0" />
                <TextBlock Text="{Binding ScanButtonText}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBox x:Name="ScanRangeBox" Style="{StaticResource MonoField}" Width="230" Tag="192.168.1.0/24" DockPanel.Dock="Left"
                     KeyDown="ScanRange_KeyDown" AutomationProperties.Name="Scan range"
                     ToolTip="A subnet (192.168.1.0/24), a range (192.168.1.10-50) or one address" />
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,0" Click="ScanUseAdapter_Click"
                    ToolTip="Fill in the selected adapter's network" AutomationProperties.Name="Use the selected adapter's network">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE839;" FontSize="12" VerticalAlignment="Center" Margin="0,1,7,0" Foreground="{StaticResource Blue}" />
                <TextBlock Text="Use adapter" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <CheckBox x:Name="DiscoverSwitch" Style="{StaticResource Switch}" IsChecked="True" Margin="18,0,12,0" VerticalAlignment="Center"
                      Content="Other subnets too" AutomationProperties.Name="Find cameras on other subnets"
                      ToolTip="Uses ONVIF, UPnP and mDNS discovery, which reach devices whatever their IP address" />
          </DockPanel>
          <StackPanel Grid.Row="2" Margin="0,14,0,12">
            <Grid Height="4">
              <Border CornerRadius="2" Background="{StaticResource Line}" />
              <Border CornerRadius="2" Background="{StaticResource BrandGradientH}" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                  <ScaleTransform ScaleX="{Binding ScanFraction}" />
                </Border.RenderTransform>
              </Border>
            </Grid>
            <TextBlock Text="{Binding ScanStatus}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0" />
          </StackPanel>
          <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,14,10,8">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,8,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="Auto" MinWidth="150" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ColumnHead}" Grid.Column="1" Text="DEVICE" />
                <TextBlock Style="{StaticResource ColumnHead}" Grid.Column="2" Text="IP ADDRESS" />
                <TextBlock Style="{StaticResource ColumnHead}" Grid.Column="3" Text="OPEN PORTS" />
              </Grid>
              <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                  <ItemsControl ItemsSource="{Binding ScanItems}" Focusable="False" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="20" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="150" />
                              <ColumnDefinition Width="120" />
                              <ColumnDefinition Width="Auto" MinWidth="150" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="dot" Width="7" Height="7" Fill="{StaticResource Success}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <Border Style="{StaticResource Badge}" Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                  <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Purple}" />
                                </Border>
                              </StackPanel>
                              <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Ip}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding IpNote}" FontSize="11.5" TextWrapping="Wrap">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsOtherSubnet}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding PortsText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                              <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,6,0" Content="Reach it" Click="ReachIt_Click"
                                      Visibility="{Binding IsOtherSubnet, Converter={StaticResource BoolToVis}}"
                                      ToolTip="Add an address in this device's subnet to the adapter, then open it"
                                      AutomationProperties.Name="{Binding Ip, StringFormat=Reach {0}}" />
                              <Button Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="13" Content="&#xE774;" Click="OpenScanned_Click"
                                      IsEnabled="{Binding CanOpenWeb}" ToolTip="Open its web page" AutomationProperties.Name="{Binding Ip, StringFormat=Open {0} in browser}" />
                              <Button Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="13" Content="&#xE9D9;" Click="PingScanned_Click"
                                      ToolTip="Ping it" AutomationProperties.Name="{Binding Ip, StringFormat=Ping {0}}" />
                              <Button Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="13" Content="&#xE718;" Click="ReserveScanned_Click"
                                      IsEnabled="{Binding HasMac}" ToolTip="Reserve this IP in the DHCP pool" AutomationProperties.Name="{Binding Ip, StringFormat=Reserve {0} in DHCP pool}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsOtherSubnet}" Value="True">
                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Warning}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding ScanEmptyText}" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,12,8,0"
                           Visibility="{Binding NoScanResults, Converter={StaticResource BoolToVis}}" />
              </Grid>
            </DockPanel>
          </Border>
        </Grid>

        <!-- ===== Monitor page ===== -->
        <Grid x:Name="MonitorPage" Grid.Row="1" Grid.Column="2" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Width="130" Click="MonitorToggle_Click" VerticalAlignment="Center"
                    AutomationProperties.Name="Start or stop monitoring">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding MonitorButtonIcon}" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0" />
                <TextBlock Text="{Binding MonitorButtonText}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Monitor" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="{Binding MonitorSummary}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <DockPanel Grid.Row="1" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="MonitorFromPool_Click" Margin="4,0,0,0" AutomationProperties.Name="Add pool devices"
                    ToolTip="Add every device with an address from the DHCP pool">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE968;" FontSize="12" VerticalAlignment="Center" Margin="0,1,7,0" Foreground="{StaticResource Blue}" />
                <TextBlock Text="Add pool devices" VerticalAlignment="Center" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="MonitorFromScan_Click" Margin="4,0,0,0" AutomationProperties.Name="Add scan results"
                    ToolTip="Add every device from the last scan">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="12" VerticalAlignment="Center" Margin="0,1,7,0" Foreground="{StaticResource Blue}" />
                <TextBlock Text="Add scan results" VerticalAlignment="Center" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Add" Width="70" Margin="8,0,0,0" Click="MonitorAdd_Click" AutomationProperties.Name="Add device to monitor" />
            <TextBox x:Name="MonitorAddBox" Style="{StaticResource MonoField}" Tag="IP address, or Name=IP" KeyDown="MonitorAdd_KeyDown"
                     AutomationProperties.Name="Device to monitor" />
          </DockPanel>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14,10,8">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,8,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="86" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="166" />
                  <ColumnDefinition Width="104" />
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ColumnHead}" Text="STATUS" />
                <TextBlock Style="{StaticResource ColumnHead}" Grid.Column="1" Text="DEVICE" />
                <TextBlock Style="{StaticResource ColumnHead}" Grid.Column="2" Text="LAST 60 SECONDS" />
                <TextBlock Style="{StaticResource ColumnHead}" Grid.Column="3" Text="LATENCY" />
                <TextBlock Style="{StaticResource ColumnHead}" Grid.Column="4" Text="LOSS" />
              </Grid>
              <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                  <ItemsControl ItemsSource="{Binding MonitorItems}" Focusable="False" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,7">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="86" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="166" />
                              <ColumnDefinition Width="104" />
                              <ColumnDefinition Width="56" />
                              <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                              <TextBlock x:Name="state" Text="{Binding StateText}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Ip}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                            <Border Grid.Column="2" Width="150" Height="26" HorizontalAlignment="Left" Background="{StaticResource SurfaceAlt}" CornerRadius="4">
                              <Grid>
                                <Polyline Points="{Binding SparkPoints}" Stroke="{StaticResource Teal}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                <Path Data="{Binding LossMarks}" Stroke="{StaticResource Danger}" StrokeThickness="2" />
                              </Grid>
                            </Border>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                              <TextBlock Text="{Binding LastText}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding AvgText}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                            <TextBlock x:Name="loss" Grid.Column="4" Text="{Binding LossText}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <Button Grid.Column="5" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="11" Content="&#xE711;"
                                    HorizontalAlignment="Right" Click="MonitorRemove_Click" ToolTip="Stop watching"
                                    AutomationProperties.Name="{Binding Name, StringFormat=Stop watching {0}}" />
                          </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding Kind}" Value="up">
                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Success}" />
                            <Setter TargetName="state" Property="Foreground" Value="{StaticResource Success}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="slow">
                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Warning}" />
                            <Setter TargetName="state" Property="Foreground" Value="{StaticResource Warning}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="down">
                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Danger}" />
                            <Setter TargetName="state" Property="Foreground" Value="{StaticResource Danger}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding HasLoss}" Value="True">
                            <Setter TargetName="loss" Property="Foreground" Value="{StaticResource Danger}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="Nothing to watch yet. Type an IP above, or add everything from your last scan or the DHCP pool."
                           Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,12,8,0"
                           Visibility="{Binding NoMonitorItems, Converter={StaticResource BoolToVis}}" />
              </Grid>
            </DockPanel>
          </Border>
        </Grid>

        <!-- ===== Tools page ===== -->
        <ScrollViewer x:Name="ToolsPage" Grid.Row="1" Grid.Column="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Margin="-12,-12,-12,0" Padding="12,12,12,0">
          <StackPanel>
            <StackPanel Margin="0,0,0,14">
              <TextBlock Text="Tools" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="Checks that run from the selected adapter, so they test the network you are plugged into."
                         FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Port check -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource Overline}" Text="PORT CHECK" />
                <DockPanel Margin="0,10,0,0">
                  <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Check" Width="90" Margin="8,0,0,0" Click="PortCheck_Click" AutomationProperties.Name="Check ports" />
                  <TextBox x:Name="PortHostBox" DockPanel.Dock="Left" Style="{StaticResource MonoField}" Width="170" Tag="Device IP" AutomationProperties.Name="Port check device" />
                  <TextBox x:Name="PortListBox" Style="{StaticResource MonoField}" Margin="8,0,0,0" Text="80, 443, 554, 8000, 37777, 22, 23, 3389"
                           AutomationProperties.Name="Ports to check" ToolTip="Ports or ranges, such as 80, 443, 8000-8010" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding PortChips}" Margin="0,10,0,0" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="chip" CornerRadius="11" Padding="10,3" Margin="0,0,6,6" Background="{StaticResource SurfaceAlt}"
                              BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse x:Name="dot" Width="6" Height="6" Fill="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                          <TextBlock x:Name="label" Text="{Binding Text}" FontSize="12" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Open}" Value="True">
                          <Setter TargetName="chip" Property="Background" Value="{StaticResource SuccessSoft}" />
                          <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource SuccessSoft}" />
                          <Setter TargetName="dot" Property="Fill" Value="{StaticResource Success}" />
                          <Setter TargetName="label" Property="Foreground" Value="{StaticResource Success}" />
                          <Setter TargetName="label" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding PortSummary}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- RTSP -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource Overline}" Text="RTSP STREAM CHECK" />
                <TextBlock Text="Asks the camera to describe its stream, without playing it. Proves video is being served." FontSize="12"
                           Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBox x:Name="RtspUrlBox" Style="{StaticResource MonoField}" Margin="0,10,0,0" Tag="rtsp://192.168.1.20:554/Streaming/Channels/101"
                         AutomationProperties.Name="RTSP address" />
                <DockPanel Margin="0,8,0,0">
                  <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Check" Width="90" Margin="8,0,0,0" Click="RtspCheck_Click" AutomationProperties.Name="Check RTSP stream" />
                  <TextBox x:Name="RtspUserBox" DockPanel.Dock="Left" Style="{StaticResource Field}" Width="170" Tag="Username (optional)" AutomationProperties.Name="Camera username" />
                  <Grid Margin="8,0,0,0">
                    <PasswordBox x:Name="RtspPasswordBox" Style="{StaticResource PasswordField}" AutomationProperties.Name="Camera password"
                                 ToolTip="Only sent to the camera. Never saved." PasswordChanged="RtspPassword_Changed" />
                    <TextBlock x:Name="RtspPasswordHint" Text="Password (optional)" Foreground="{StaticResource Faint}" FontSize="13.5"
                               VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                  </Grid>
                </DockPanel>
                <TextBlock Text="{Binding RtspSummary}" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
              </StackPanel>
            </Border>

            <!-- Traceroute -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource Overline}" Text="TRACEROUTE" />
                <DockPanel Margin="0,10,0,0">
                  <Button x:Name="TraceButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding TraceButtonText}" Width="90"
                          Margin="8,0,0,0" Click="Trace_Click" AutomationProperties.Name="Start or stop traceroute" />
                  <TextBox x:Name="TraceTargetBox" Style="{StaticResource MonoField}" Tag="Address or name, e.g. 8.8.8.8" AutomationProperties.Name="Traceroute target" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding TraceHops}" Margin="0,10,0,0" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="30" />
                          <ColumnDefinition Width="140" />
                          <ColumnDefinition Width="90" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Hop}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Faint}" />
                        <TextBlock x:Name="addr" Grid.Column="1" Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                        <TextBlock Grid.Column="2" Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}" />
                        <TextBlock Grid.Column="3" Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Reached}" Value="True">
                          <Setter TargetName="addr" Property="Foreground" Value="{StaticResource Success}" />
                          <Setter TargetName="addr" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- DNS -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource Overline}" Text="DNS LOOKUP" />
                <DockPanel Margin="0,10,0,0">
                  <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Look up" Width="90" Margin="8,0,0,0" Click="DnsLookup_Click" AutomationProperties.Name="Look up DNS" />
                  <TextBox x:Name="DnsServerBox" DockPanel.Dock="Right" Style="{StaticResource MonoField}" Width="150" Margin="8,0,0,0" Tag="Server (optional)"
                           AutomationProperties.Name="DNS server" ToolTip="Leave empty to use Windows' DNS, or enter a server such as the one a camera uses" />
                  <TextBox x:Name="DnsNameBox" Style="{StaticResource MonoField}" Tag="Name or IP, e.g. nvr.site.local" AutomationProperties.Name="Name to look up" />
                </DockPanel>
                <TextBlock Text="{Binding DnsResult}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- Link health -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Refresh" Height="34" Click="LinkRefresh_Click" AutomationProperties.Name="Refresh link health" />
                  <TextBlock Style="{StaticResource Overline}" Text="LINK HEALTH" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding LinkReport}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LinkAdvice}" FontSize="12" Foreground="{StaticResource Warning}" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Toast -->
        <Border x:Name="Toast" Grid.RowSpan="2" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                CornerRadius="12" Background="#0E2744" Padding="16,10" Opacity="0" IsHitTestVisible="False" Effect="{StaticResource PopupShadow}">
          <Border.RenderTransform>
            <TranslateTransform x:Name="ToastShift" Y="12" />
          </Border.RenderTransform>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ToastIcon" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="13" VerticalAlignment="Center" MaxWidth="520" TextWrapping="Wrap" />
            <Button x:Name="ToastAction" Style="{StaticResource GhostButton}" Foreground="#7FDCEC" Height="30" Margin="12,0,-6,0"
                    FontWeight="SemiBold" Visibility="Collapsed" Click="ToastAction_Click" />
          </StackPanel>
        </Border>
      </Grid>

      </Grid>

      <!-- ===== Activity log ===== -->
      <Border Grid.Row="3" Height="170" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
              Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource BoolToVis}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,10">
          <ItemsControl ItemsSource="{Binding Log}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                  <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Faint}" Width="70" />
                  <Ellipse x:Name="dot" Width="7" Height="7" Fill="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="900" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="ok">
                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource Success}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="error">
                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource Danger}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- ===== Footer ===== -->
      <Border Grid.Row="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <DockPanel Margin="22,0,12,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="BrandText" Text="cre8labs.uk" Foreground="{StaticResource Faint}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" />
            <ToggleButton x:Name="LogToggle" Style="{StaticResource FooterToggle}" Tag="&#xE81C;" Content="Activity"
                          AutomationProperties.Name="Activity" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="FooterDot" Width="7" Height="7" Fill="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,9,0" />
            <TextBlock x:Name="FooterText" Text="Ready" FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
