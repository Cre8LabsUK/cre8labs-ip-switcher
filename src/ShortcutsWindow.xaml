<Window x:Class="Cre8Labs.IPSwitcher.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:Cre8Labs.IPSwitcher.Input"
        Title="Keyboard shortcuts"
        Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="Assets/app.ico"
        Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource Ink}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="64" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <StackPanel>
    <!-- Header -->
    <Grid Height="64">
      <StackPanel VerticalAlignment="Center" Margin="24,0,0,0">
        <TextBlock Text="Keyboard shortcuts" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Click a box and press the keys you want. Backspace clears it." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,1,0,0" />
      </StackPanel>
      <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" Height="40"
              WindowChrome.IsHitTestVisibleInChrome="True" IsCancel="True" Click="Cancel_Click" AutomationProperties.Name="Close" />
    </Grid>
    <Border Height="3" Background="{StaticResource BrandGradientH}" />

    <StackPanel Margin="24,20,24,8">
      <!-- Switches -->
      <Border CornerRadius="12" Padding="16,14" Background="{StaticResource SurfaceAlt}">
        <StackPanel>
          <CheckBox x:Name="EnabledSwitch" Style="{StaticResource Switch}" FontWeight="SemiBold"
                    Content="Use keyboard shortcuts" AutomationProperties.Name="Use keyboard shortcuts" />
          <CheckBox x:Name="GlobalSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0"
                    Content="Also work when IP Switcher is in the background" AutomationProperties.Name="Also work in the background" />
          <TextBlock Margin="50,4,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                     Text="Background shortcuts must include Ctrl, Alt or Win, so they never take over normal typing in other apps." />
        </StackPanel>
      </Border>

      <!-- Shortcut list -->
      <Grid Margin="0,18,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="190" />
          <ColumnDefinition Width="44" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource Overline}" Text="ACTION" />
        <TextBlock Style="{StaticResource Overline}" Grid.Column="1" Text="SHORTCUT" />
      </Grid>

      <ScrollViewer x:Name="ListScroll" MaxHeight="330" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,-12,0" Padding="0,4,12,0">
        <ItemsControl x:Name="RowList" ItemsSource="{Binding Rows}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="190" />
                  <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                <input:ShortcutBox Grid.Column="1" Style="{StaticResource MonoField}" Tag="None"
                                   Gesture="{Binding Gesture, UpdateSourceTrigger=PropertyChanged}"
                                   AutomationProperties.Name="{Binding Label, StringFormat=Shortcut for {0}}" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" HorizontalAlignment="Right"
                        Click="ClearRow_Click" ToolTip="Remove shortcut"
                        AutomationProperties.Name="{Binding Label, StringFormat=Remove shortcut for {0}}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Error}" FontSize="12" Margin="2,5,0,0"
                           Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>

    <!-- Footer -->
    <Border Margin="0,8,0,0" Padding="16,14,24,18" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Width="96" Click="Cancel_Click" />
          <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save shortcuts" Margin="10,0,0,0" IsDefault="True" Click="Save_Click" />
        </StackPanel>
        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="Reset_Click" ToolTip="Restore 1 to 9, 0 for DHCP, Ctrl+N and F5">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE777;" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Blue}" />
            <TextBlock Text="Reset to defaults" VerticalAlignment="Center" Foreground="{StaticResource Blue}" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
      </DockPanel>
    </Border>
  </StackPanel>
</Window>
